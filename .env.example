# =============================================================================
# Autonomous Engineering Intelligence Platform — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# =============================================================================
# APPLICATION
# =============================================================================
APP_NAME="Autonomous Engineering Intelligence Platform"
APP_VERSION="0.1.0"
APP_ENV="development"           # development | staging | production
DEBUG=true
SECRET_KEY="change-me-to-a-random-64-char-secret-key-before-production"
API_PREFIX="/api/v1"

# CORS allowed origins (comma-separated)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# =============================================================================
# DATABASE (PostgreSQL)
# =============================================================================
# For full stack with Docker Compose:
DATABASE_URL="postgresql+asyncpg://aeip:aeip_password@localhost:5432/aeip"

# For lightweight local dev WITHOUT Docker (SQLite):
# DATABASE_URL="sqlite+aiosqlite:///./aeip_dev.db"

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false                   # Set true to log all SQL queries

# =============================================================================
# CACHE / QUEUE (Redis)
# =============================================================================
# For full stack with Docker Compose:
REDIS_URL="redis://localhost:6379/0"

# For lightweight local dev WITHOUT Redis (fakeredis in-process):
# REDIS_URL="fake://"

# =============================================================================
# VECTOR DATABASE (Qdrant)
# =============================================================================
QDRANT_URL="http://localhost:6333"
QDRANT_API_KEY=""               # Leave empty for local unauthenticated instance
QDRANT_COLLECTION_PREFIX="aeip"

# =============================================================================
# OBJECT STORAGE (S3-compatible / MinIO)
# =============================================================================
STORAGE_PROVIDER="minio"        # minio | s3 | local
STORAGE_ENDPOINT="http://localhost:9000"
STORAGE_ACCESS_KEY="aeip_minio"
STORAGE_SECRET_KEY="aeip_minio_secret"
STORAGE_BUCKET="aeip-artifacts"
STORAGE_REGION="us-east-1"

# For local file storage (no MinIO required):
# STORAGE_PROVIDER="local"
# STORAGE_LOCAL_PATH="./investigation_artifacts"

# =============================================================================
# LLM CONFIGURATION
# =============================================================================
# Provider: openai | anthropic | gemini | ollama
LLM_PROVIDER="openai"

# OpenAI
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"    # Override for Azure OpenAI or proxies
LLM_MODEL="gpt-4o"
LLM_FAST_MODEL="gpt-4o-mini"                   # Used for lower-stakes reasoning

# Anthropic (if LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=""
# LLM_MODEL="claude-sonnet-4-5"
# LLM_FAST_MODEL="claude-haiku-3-5"

# Google Gemini (if LLM_PROVIDER=gemini)
GEMINI_API_KEY=""
# LLM_MODEL="gemini-2.0-flash"
# LLM_FAST_MODEL="gemini-2.0-flash-lite"

# Ollama (if LLM_PROVIDER=ollama) — run `ollama serve` separately
OLLAMA_BASE_URL="http://localhost:11434"
# LLM_MODEL="llama3.1:8b"
# LLM_FAST_MODEL="llama3.1:8b"

# LLM Behavior
LLM_TEMPERATURE=0.1             # Low temperature for more deterministic reasoning
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=120

# Cost / Budget Controls (per investigation)
INVESTIGATION_MAX_TOKENS=500000
INVESTIGATION_MAX_TOOL_CALLS=200
INVESTIGATION_MAX_DURATION_SECONDS=3600
INVESTIGATION_MAX_RETRIES=3

# =============================================================================
# AUTHENTICATION
# =============================================================================
JWT_SECRET_KEY="change-me-jwt-secret-key-before-production"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# =============================================================================
# OBSERVABILITY
# =============================================================================
# OpenTelemetry
OTEL_ENABLED=true
OTEL_SERVICE_NAME="aeip-backend"
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4317"
OTEL_EXPORTER_OTLP_PROTOCOL="grpc"

# Prometheus metrics
METRICS_ENABLED=true
METRICS_PORT=9090

# Structured logging
LOG_LEVEL="INFO"                # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FORMAT="json"               # json | text

# =============================================================================
# SANDBOX (Code Execution)
# =============================================================================
SANDBOX_PROVIDER="docker"       # docker | subprocess (subprocess = no isolation, dev only)
SANDBOX_IMAGE="aeip-sandbox:latest"
SANDBOX_CPU_LIMIT="1.0"         # CPU cores
SANDBOX_MEMORY_LIMIT="512m"     # Memory limit
SANDBOX_TIMEOUT_SECONDS=60
SANDBOX_NETWORK_DISABLED=true

# =============================================================================
# GIT
# =============================================================================
GIT_WORKSPACE_PATH="./git_workspaces"
GIT_MAX_DIFF_LINES=10000
GIT_CLONE_TIMEOUT_SECONDS=120

# =============================================================================
# INVESTIGATION DEFAULTS
# =============================================================================
INVESTIGATION_DEFAULT_PRIORITY="medium"
INVESTIGATION_CHECKPOINT_ENABLED=true
INVESTIGATION_PARALLEL_TASKS_MAX=5

# Human approval requirements
REQUIRE_APPROVAL_FOR_PATCH=true
REQUIRE_APPROVAL_FOR_BRANCH=true
REQUIRE_APPROVAL_FOR_PR=true

# =============================================================================
# RATE LIMITING
# =============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_INVESTIGATIONS_PER_HOUR=10

# =============================================================================
# FRONTEND (Next.js — read at build time)
# =============================================================================
NEXT_PUBLIC_API_URL="http://localhost:8000"
NEXT_PUBLIC_WS_URL="ws://localhost:8000"
NEXT_PUBLIC_APP_NAME="AEIP"
